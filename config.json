{
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 8080,
      "https": false
    }
  ],
  "plugins": [
    {
      "name": "drogon::plugin::RealIpResolver",
      "dependencies": [],
      "config": {
        "trust_ips": [],
        "from_header": "x-forwarded-for",
        "attribute_key": "real-ip",
        "_note": "trust_ips 的语义是「我信任谁的 X-Forwarded-For」——你声明谁是代理，就等于让那个来源决定频控 key。本项目当前【不挂反向代理】，故取 []：列表为空则 matchCidr 永不成立，X-Forwarded-For 一律忽略，伪造没有入口。将来接入 nginx（与 Drogon 同机）填 127.0.0.1，Docker 网络填网段（如 172.16.0.0/12）。两个方向都别填错：① 填窄了（对端不在列表内）——插件忽略 XFF、退回 TCP 对端地址，伪造无效，但反代后的真实 IP 取不到，所有请求退化成同一个代理 IP，同 IP 频控会误伤全部用户；② 填宽了（把客户端也能连到的地址、或 0.0.0.0/0 放进列表）——该来源的 XFF 会被采信，伪造当场生效，一行 header 即可绕过频控。改完可用 scripts/e2e-311-real-ip.sh 跑两相验证。"
      }
    }
  ],
  "app": {
    "threads_num": 4,
    "log_path": "./logs",
    "log_level": "warn",
    "run_as_daemon": false
  },
  "custom_config": {
    "async_log": {
      "file": "./logs/seckill.log",
      "level": "warn"
    },
    "jwt": {
      "secret": "CHANGE_ME_please_use_a_long_random_string_in_production",
      "issuer": "seckill-cpp",
      "ttl_seconds": 7200
    },
    "sms": {
      "code_ttl_seconds": 300,
      "resend_interval_seconds": 60,
      "daily_limit": 10,
      "max_verify_attempts": 5
    },
    "login_guard": {
      "max_fail": 5,
      "lock_seconds": 600
    },
    "register_limit": {
      "max_per_ip": 5,
      "window_seconds": 3600
    },
    "auth": {
      "require_sms_on_register": true,
      "require_sms_on_login": false,
      "min_password_length": 6
    },
    "seckill_lock": {
      "mode": "none",
      "shards": 64,
      "bits": 65536
    },
    "cache": {
      "enabled": true,
      "key_prefix": "seckill",
      "key_version": "v1",
      "list_ttl_seconds": 30,
      "detail_ttl_seconds": 60,
      "null_ttl_seconds": 60,
      "jitter_seconds": 30,
      "double_delete_ms": 0,
      "bloom_enabled": false,
      "bloom_capacity": 500000,
      "bloom_error_rate": 0.001,
      "local_enabled": false,
      "local_capacity": 4096,
      "invalidate_on_order": "item"
    }
  },
  "db_clients": [
    {
      "name": "default",
      "rdbms": "mysql",
      "host": "127.0.0.1",
      "port": 3306,
      "dbname": "seckill",
      "user": "seckill",
      "passwd": "seckill",
      "connection_number": 10
    }
  ],
  "redis_clients": [
    {
      "name": "default",
      "host": "127.0.0.1",
      "port": 6379,
      "passwd": "",
      "connection_number": 16,
      "timeout": -1
    }
  ]
}
