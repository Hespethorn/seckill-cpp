{
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 8080,
      "https": false
    }
  ],
  "app": {
    "threads_num": 4,
    "log_path": "./logs",
    "log_level": "warn",
    "run_as_daemon": false
  },
  "custom_config": {
    "async_log": {
      "file": "./logs/seckill.log",
      "level": "warn"
    },
    "jwt": {
      "secret": "CHANGE_ME_please_use_a_long_random_string_in_production",
      "issuer": "seckill-cpp",
      "ttl_seconds": 7200
    },
    "sms": {
      "code_ttl_seconds": 300,
      "resend_interval_seconds": 60,
      "daily_limit": 10,
      "max_verify_attempts": 5
    },
    "login_guard": {
      "max_fail": 5,
      "lock_seconds": 600
    },
    "register_limit": {
      "max_per_ip": 5,
      "window_seconds": 3600
    },
    "auth": {
      "require_sms_on_register": true,
      "require_sms_on_login": false,
      "min_password_length": 6
    },
    "seckill_lock": {
      "mode": "none",
      "shards": 64,
      "bits": 65536
    },
    "cache": {
      "enabled": true,
      "key_prefix": "seckill",
      "key_version": "v1",
      "list_ttl_seconds": 30,
      "detail_ttl_seconds": 60,
      "null_ttl_seconds": 60,
      "jitter_seconds": 30,
      "invalidate_on_order": "item"
    }
  },
  "db_clients": [
    {
      "name": "default",
      "rdbms": "mysql",
      "host": "127.0.0.1",
      "port": 3306,
      "dbname": "seckill",
      "user": "seckill",
      "passwd": "seckill",
      "connection_number": 10
    }
  ],
  "redis_clients": [
    {
      "name": "default",
      "host": "127.0.0.1",
      "port": 6379,
      "passwd": "",
      "connection_number": 16,
      "timeout": -1
    }
  ]
}
